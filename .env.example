# Copy file này thành .env rồi điền giá trị thật vào, không commit .env lên git.

# Bắt buộc — token của bot, lấy từ Discord Developer Portal
DISCORD_TOKEN=

# Cần ít nhất 1 trong 3 key ảnh dưới đây (không bắt buộc phải có đủ cả 3)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Tính năng hỏi đáp (cogs/ask.py) — cần ít nhất 1 trong 3 key dưới đây.
# QAAggregator thử lần lượt theo đúng thứ tự này và tự fallback khi lỗi:
# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Vyce AI (https://vyceai.com) — dự phòng CUỐI cho hỏi đáp, ĐỒNG THỜI là
# nguồn DUY NHẤT cho lệnh /gen_img (tạo ảnh bằng AI). Tính tiền theo credit.
VYCE_API_KEY=
